# Copy this file to .env and fill in your own values

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fortran

# Secret used to sign JWT tokens - use a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# How long submitted code is allowed to run before it is killed (ms)
CODE_EXEC_TIMEOUT_MS=5000

# --- Docker sandbox settings (used by services/codeExecutor.js) ---
# Docker Desktop/Engine must be installed and running on this machine.
# Build the sandbox image once first: see README "Docker setup".
RUNNER_IMAGE=oj-code-runner:latest
DOCKER_MEMORY_LIMIT_MB=256
DOCKER_CPU_LIMIT=0.5
DOCKER_PIDS_LIMIT=64
